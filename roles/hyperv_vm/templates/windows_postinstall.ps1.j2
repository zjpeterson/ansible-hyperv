$password = "{{ hyperv_vm_admin_pass }}"
$secString = ConvertTo-SecureString $password -AsPlainText -Force
$cred = New-Object System.Management.Automation.PSCredential ("Administrator", $secString)

$scriptBlock = {
    # --- 0. EXPAND C: DRIVE ---    
    # Finds the maximum available space on the disk and stretches the C: partition to fill it
    $size = Get-PartitionSupportedSize -DriveLetter C
    $currentSize = (Get-Partition -DriveLetter C).Size

    # Only expand if there is more than 1MB of free space available
    if ($size.SizeMax -gt ($currentSize + 1MB)) {
        Resize-Partition -DriveLetter C -Size $size.SizeMax
    }

    # --- 1. NETWORK CONFIGURATION ---
    $netAdapter = Get-NetAdapter | Where-Object Status -eq "Up"
    New-NetIPAddress -InterfaceAlias $netAdapter.Name -IPAddress {{ hyperv_vm_ip}} -PrefixLength {{ hyperv_vm_prefix }} -DefaultGateway {{ hyperv_vm_gw }} -Confirm:$false
    Set-DnsClientServerAddress -InterfaceAlias $netAdapter.Name -ServerAddresses {{ hyperv_vm_dns }}
    
    # --- 2. WINRM CONFIGURATION ---
    # Enables the WinRM service and sets up the HTTP listener
    # Note: Added -SkipNetworkProfileCheck to prevent errors if Windows thinks the new IP is a "Public" network
    Enable-PSRemoting -Force -SkipNetworkProfileCheck

    # Allows local user accounts to be used with WinRM
    $tokenFilterParams = @{
        Path         = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System'
        Name         = 'LocalAccountTokenFilterPolicy'
        Value        = 1
        PropertyType = 'DWORD'
        Force        = $true
    }
    New-ItemProperty @tokenFilterParams

    # Create self signed certificate
    $certParams = @{
        CertStoreLocation = 'Cert:\LocalMachine\My'
        DnsName           = $env:COMPUTERNAME
        NotAfter          = (Get-Date).AddYears(1)
        Provider          = 'Microsoft Software Key Storage Provider'
        Subject           = "CN=$env:COMPUTERNAME"
    }
    $cert = New-SelfSignedCertificate @certParams

    # Create HTTPS listener
    $httpsParams = @{
        Path                  = 'WSMan:\localhost\Listener'
        Address               = '*'
        CertificateThumbprint = $cert.Thumbprint
        Enabled               = $true
        Port                  = 5986
        Transport             = 'HTTPS'
        Force                 = $true
    }
    New-Item @httpsParams
    
    # Explicitly allow Basic Auth (Required for standard local admin connections in Ansible)
    Set-Item WSMan:\localhost\Service\Auth\Basic -Value $true

    # --- 3. ENABLE RDP ---
    # Flip the registry key to allow remote connections
    Set-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Terminal Server' -Name "fDenyTSConnections" -Value 0
}

# Execute the script block inside the VM
Invoke-Command -VMName "{{ hyperv_vm_name }}" -Credential $cred -ScriptBlock $scriptBlock
